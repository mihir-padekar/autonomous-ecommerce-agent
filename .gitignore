# ==============================================================================
# Autonomous E-Commerce Operations Copilot — .gitignore
# ==============================================================================

# Virtual Environments
.venv/
venv/
ENV/
env/

# Environment Variables & Secrets (CRITICAL: Never commit credentials)
.env
*.env
!.env.example
secrets.json
credentials.json

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Local Vector Databases & Embeddings Cache
chroma_db/
.chroma/

# LangGraph & Checkpointer Caches
.langgraph/

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db

# Archives & Temporary Dumps
*.zip
*.tar.gz
*.rar
*.log
temp/
tmp/

# Build & Packaging Artefacts
build/
dist/
*.egg-info/
