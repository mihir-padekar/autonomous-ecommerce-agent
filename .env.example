# ==============================================================================
# Autonomous E-Commerce Operations Copilot — Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual credentials.
# DO NOT commit your actual .env file to version control.
# ==============================================================================

# LLM Provider (Groq Cloud: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
PRIMARY_MODEL=qwen/qwen3.8-27b
FALLBACK_MODEL=openai/gpt-oss-120b
TEMPERATURE=0.0
MAX_RETRIES=2

# PostgreSQL Database (Neon Serverless PostgreSQL or local PostgreSQL)
# Example: postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@your_host/your_db?sslmode=require

# Vector Database & Embeddings
CHROMA_PERSIST_DIRECTORY=chroma_db
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# MCP Tool Server
MCP_SERVER_NAME=ecommerce-operations-tools
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001

# Observability (Optional: Langfuse Cloud: https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

